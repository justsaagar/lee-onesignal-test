#!/usr/bin/env bash
# .husky/pre-push
# Proofed pre-push hook for Stackap Solution.
# Runs analyzer (and optionally formatter) before allowing push.

set -euo pipefail

echo "[huskyless] Starting pre-push checks..."

# Ensure dart is available
if ! command -v dart >/dev/null 2>&1; then
  echo "Error: 'dart' is not found in PATH. Ensure Dart SDK (or Flutter SDK) is installed."
  exit 2
fi

# Detect flutter repo (optional)
IS_FLUTTER_REPO=false
if command -v flutter >/dev/null 2>&1 && [ -f "pubspec.yaml" ]; then
  IS_FLUTTER_REPO=true
fi

# Analyzer step: prefer full analysis for reliability
echo "[huskyless] Running dart analyze..."
if ! dart analyze; then
  echo "Error: dart analyze failed. Fix issues before pushing."
  exit 1
fi

# Optional Flutter analyze (extra safety for Flutter repos)
if [ "$IS_FLUTTER_REPO" = true ]; then
  echo "[huskyless] Detected Flutter repo. Optionally running 'flutter analyze' (comment/uncomment to toggle)..."
  # Uncomment to enforce Flutter analyzer as well
  # if ! flutter analyze; then
  #   echo "Error: flutter analyze failed. Fix issues before pushing."
  #   exit 1
  # fi
fi

# Optional: enforce format again (uncomment if desired)
# echo "[huskyless] Running dart format check..."
# dart format --set-exit-if-changed .

echo "[huskyless] Pre-push checks passed. Ready to push."
exit 0